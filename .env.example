# ==============================================================================
# DULCE ARTE - SISTEMA DE TRAZABILIDAD Y GESTIÓN DE PEDIDOS (PASTELERÍA ARTESANAL)
# Configuración de Variables de Entorno (AWS EC2 & Desarrollo Local)
# ==============================================================================

# Seguridad y Entorno Django
SECRET_KEY=django-insecure-dulce-arte-eva3-backend-secret-key-2026-aws-ec2
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Configuración de Base de Datos Relacional PostgreSQL (Criterio 1 Rúbrica)
# Para usar PostgreSQL en AWS EC2 o local: DB_ENGINE=postgresql
# Para pruebas rápidas sin servidor PostgreSQL activo: DB_ENGINE=sqlite3
DB_ENGINE=postgresql
DB_NAME=dulce_arte_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Metadatos de Despliegue AWS EC2
AWS_EC2_PUBLIC_IP=PENDIENTE_ASIGNAR_IP_ELASTICA_O_PUBLICA
